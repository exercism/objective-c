NS_ASSUME_NONNULL_BEGIN


@interface {{ test_class }} : XCTestCase

@end

@implementation {{ test_class }}
{% for case in cases %}
- (void){{ case.func_name }} {
    {{ solution_class }} *{{ solution_class.lower() }} = [[{{ solution_class }} alloc] initWithString:{{ case.input.subject | quote }}];
    NSArray<NSString *> *results = [{{ solution_class.lower() }} match:{{ case.input.candidates | quote }}];
    NSArray<NSString *> *expected = {{ case.expected | quote }};
    XCTAssertEqualObjects(results, expected);
}
{% endfor %}
@end
NS_ASSUME_NONNULL_END
