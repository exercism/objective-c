#import <XCTest/XCTest.h>

#if __has_include("{{ example_header }}")
# import "{{ example_header }}"
#else
# import "{{ header }}"
#endif

@interface {{ test_class }} : XCTestCase

@end

@implementation {{ test_class }}
{% for case in cases %}
- (void){{ case.func_name }} {
    {{ solution_class }} *grains = [[{{ solution_class }} alloc] init];
{%- if case.expect_error %}
    XCTAssertEqual(-1, [grains grainsAtSquareNumber:{{ case.input.square }}]);
{%- elif case.property == 'square' %}
    XCTAssertEqual({{ case.expected }}ULL, [grains grainsAtSquareNumber:{{ case.input.square }}]);
{%- else %}
    XCTAssertEqual({{ case.expected }}ULL, [grains grainsAtBoard]);
{%- endif %}
}
{% endfor %}
@end
