#import <XCTest/XCTest.h>

#if __has_include("{{ example_header }}")
# import "{{ example_header }}"
#else
# import "{{ header }}"
#endif

@interface {{ test_class }} : XCTestCase

@end

@implementation {{ test_class }}
{% for case in cases %}
- (void){{ case.func_name }} {
    NSArray<NSNumber *> *input = {{ case.input.array | quote }};
    {{ solution_class }} *binary = [[{{ solution_class }} alloc] initWithArray:input];
{%- if case.expect_error %}
    XCTAssertEqual(NSNotFound, [binary searchFor:{{ case.input.value }}]);
{%- else %}
    XCTAssertEqual({{ case.expected }}, [binary searchFor:{{ case.input.value }}]);
{%- endif %}
}
{% endfor %}
@end
