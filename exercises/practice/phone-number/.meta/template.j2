#import <XCTest/XCTest.h>

#if __has_include("{{ example_header }}")
# import "{{ example_header }}"
#else
# import "{{ header }}"
#endif

@interface {{ test_class }} : XCTestCase

@end

@implementation {{ test_class }}
{% for case in cases %}
- (void){{ case.func_name }} {
    NSString *startingNumber = {{ case.input.phrase | quote }};
    {{ solution_class }} *phoneNumber = [[{{ solution_class }} alloc] initWithString:startingNumber];
{%- if case.expect_error %}
    XCTAssertEqualObjects(@"0000000000", [phoneNumber number]);
{%- else %}
    XCTAssertEqualObjects({{ case.expected | quote }}, [phoneNumber number]);
{%- endif %}
}
{% endfor %}
@end
