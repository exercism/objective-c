#import <XCTest/XCTest.h>

#if __has_include("{{ example_header }}")
# import "{{ example_header }}"
#else
# import "{{ header }}"
#endif

@interface {{ test_class }} : XCTestCase

@end

@implementation {{ test_class }}
{% for case in cases %}
- (void){{ case.func_name }} {
{%- if not case.expect_error %}
    XCTAssertEqualObjects({{ case.expected | quote }}, [{{ solution_class }} {{ case.property }}:{{ case.given }}]);
{%- else %}
    XCTAssertNil([{{ solution_class }} {{ case.property}}:{{ case.given }}]);
{%- endif %}
}
{% endfor %}
@end
